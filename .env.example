# ============================================================
# RankRiseUSA Outreach Automation Platform - Environment Config
# ============================================================

# APPLICATION
APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
NODE_ENV=development
PORT=4000

# DATABASE
DATABASE_URL=postgresql://coder@localhost:5432/rankriseusa_outreach?schema=public

# REDIS
# Note: If Redis is offline, the backend automatically uses its built-in in-memory queue fallback
REDIS_URL=redis://localhost:6379

# AUTH
SESSION_SECRET=rankrise_super_secure_session_secret_key_2026_dev_mode_32_chars

# ENCRYPTION
# 64-character hexadecimal key (32 bytes) for AES-256-GCM token encryption
EMAIL_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GOOGLE
# Obtain credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/senders/gmail/callback

# MICROSOFT
# Obtain credentials at: https://portal.azure.com/ (App Registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/senders/microsoft/callback

# EMAIL
# Options: DRY_RUN (default, logs simulated delivery) or LIVE (sends real messages via official APIs)
EMAIL_SEND_MODE=DRY_RUN

# ADMIN
ADMIN_EMAIL=admin@rankriseusa.com
ADMIN_PASSWORD=RankRiseAdmin2026!
