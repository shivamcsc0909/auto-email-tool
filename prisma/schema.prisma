// RankRiseUSA Outreach Automation Platform - Database Schema
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStatus {
  NEW
  VALIDATED
  READY
  QUEUED
  PROCESSING
  SENT
  FAILED
  BOUNCED
  SKIPPED
  PAUSED
  DO_NOT_CONTACT
}

enum SenderProvider {
  GMAIL
  MICROSOFT
}

enum SenderStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PAUSED
  RATE_LIMITED
}

enum CampaignStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETED
  STOPPED
  FAILED
}

enum CampaignLeadStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum EmailLogStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  TEMPORARY_FAILURE
  BOUNCED
  SKIPPED
}

enum SuppressionReason {
  UNSUBSCRIBED
  MANUAL_BLOCK
  BOUNCE
  INVALID
  CUSTOMER_REQUEST
  OTHER
}

enum ServiceCategory {
  WEBSITE
  APP_DEVELOPMENT
  SEO
  GOOGLE_BUSINESS_PROFILE
  DIGITAL_MARKETING
  META_ADS
  GOOGLE_ADS
  LOCAL_SEO
  GENERAL_DIGITAL_SERVICES
}

model AdminUser {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  name              String
  role              String     @default("ADMIN")
  twoFactorEnabled  Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  auditLogs         AuditLog[]

  @@map("admin_users")
}

model LeadSource {
  id             String   @id @default(cuid())
  filename       String
  originalName   String
  fileSize       Int
  rowCount       Int      @default(0)
  validCount     Int      @default(0)
  invalidCount   Int      @default(0)
  duplicateCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  leads          Lead[]

  @@map("lead_sources")
}

model Lead {
  id               String         @id @default(cuid())
  firstName        String?
  lastName         String?
  fullName         String?
  companyName      String?
  email            String
  website          String?
  domain           String?
  country          String?        @default("United States")
  city             String?
  phone            String?
  industry         String?
  serviceInterest  String?
  source           String?        @default("MANUAL_OR_FILE")
  sourceRowNumber  Int?
  customNotes      String?
  status           LeadStatus     @default(NEW)
  lastContactedAt  DateTime?
  lastSenderId     String?
  lastTemplateId   String?
  campaignId       String?
  leadSourceId     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  leadSource       LeadSource?    @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  campaignLeads    CampaignLead[]
  emailLogs        EmailLog[]

  @@index([email])
  @@index([domain])
  @@index([status])
  @@index([campaignId])
  @@index([lastSenderId])
  @@index([createdAt])
  @@map("leads")
}

model Template {
  id          String            @id @default(cuid())
  name        String
  category    ServiceCategory   @default(GENERAL_DIGITAL_SERVICES)
  categories  String[]          @default([])
  service     String?           @default("General")
  language    String            @default("en")
  subject     String
  bodyHtml    String
  bodyText    String
  variables   String[]          @default([])
  weight      Int               @default(1)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  emailLogs   EmailLog[]

  @@map("templates")
}

model SenderAccount {
  id                     String         @id @default(cuid())
  provider               SenderProvider
  email                  String         @unique
  displayName            String
  senderName             String
  title                  String?        @default("Business Development")
  company                String         @default("RANKRISEUSA")
  phone                  String?
  website                String?        @default("rankriseusa.com")
  signatureHtml          String?
  signatureText          String?
  signatureLogoUrl       String?
  oauthProvider          String?
  encryptedAccessToken   String?
  encryptedRefreshToken  String?
  tokenExpiry            DateTime?
  status                 SenderStatus   @default(DISCONNECTED)
  dailySendLimit         Int            @default(20) // Application safety cap
  sentToday              Int            @default(0)
  lastSentAt             DateTime?
  lastCounterReset       DateTime       @default(now())
  enabled                Boolean        @default(true)
  priority               Int            @default(1)
  lastErrorMessage       String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  emailLogs              EmailLog[]
  campaignLeads          CampaignLead[]

  @@index([provider])
  @@index([email])
  @@index([status])
  @@index([enabled])
  @@map("sender_accounts")
}

model Campaign {
  id                  String          @id @default(cuid())
  name                String
  description         String?
  serviceCategory     ServiceCategory @default(GENERAL_DIGITAL_SERVICES)
  templateIds         String[]        @default([])
  senderIds           String[]        @default([])
  dailyCampaignLimit  Int             @default(100)
  perSenderLimit      Int             @default(20) // Safety cap
  delayMin            Int             @default(90) // Seconds
  delayMax            Int             @default(300) // Seconds
  scheduleStart       String          @default("09:00") // HH:mm
  scheduleEnd         String          @default("17:00") // HH:mm
  timezone            String          @default("America/New_York")
  status              CampaignStatus  @default(DRAFT)
  totalLeads          Int             @default(0)
  sentLeads           Int             @default(0)
  failedLeads         Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  campaignLeads       CampaignLead[]
  emailLogs           EmailLog[]

  @@index([status])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignLead {
  id             String             @id @default(cuid())
  campaignId     String
  leadId         String
  senderId       String?
  templateId     String?
  status         CampaignLeadStatus @default(PENDING)
  attempts       Int                @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  campaign       Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead           Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender         SenderAccount?     @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  @@index([leadId])
  @@map("campaign_leads")
}

model EmailJob {
  id            String    @id @default(cuid())
  jobId         String    @unique
  queueName     String    @default("EMAIL_SEND")
  campaignId    String?
  leadId        String?
  senderId      String?
  templateId    String?
  status        String    @default("QUEUED")
  payload       String // JSON string
  errorMessage  String?
  attempts      Int       @default(0)
  scheduledFor  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@map("email_jobs")
}

model EmailLog {
  id                 String         @id @default(cuid())
  leadId             String?
  campaignId         String?
  senderId           String?
  templateId         String?
  provider           SenderProvider
  recipient          String
  subject            String
  status             EmailLogStatus @default(QUEUED)
  providerMessageId  String?
  errorCode          String?
  errorMessage       String?
  attemptNumber      Int            @default(1)
  queuedAt           DateTime       @default(now())
  startedAt          DateTime?
  sentAt             DateTime?
  createdAt          DateTime       @default(now())

  lead               Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaign           Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  sender             SenderAccount? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  template           Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([recipient])
  @@index([status])
  @@index([campaignId])
  @@index([senderId])
  @@index([createdAt])
  @@map("email_logs")
}

model SuppressionEntry {
  id        String            @id @default(cuid())
  email     String            @unique
  domain    String?
  reason    SuppressionReason @default(MANUAL_BLOCK)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([email])
  @@index([domain])
  @@index([reason])
  @@map("suppression_entries")
}

model AuditLog {
  id          String     @id @default(cuid())
  userId      String?
  module      String
  action      String
  status      String     @default("SUCCESS")
  referenceId String?
  details     String? // JSON or text
  ipAddress   String?
  createdAt   DateTime   @default(now())

  user        AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}
